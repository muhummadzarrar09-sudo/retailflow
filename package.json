{
  "name": "retailflow",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "RetailFlow \u2014 premium catalog + WhatsApp ordering system. Demo built by Zarrar.Solutions",
  "scripts": {
    "images": "node scripts/img-pipeline.mjs",
    "images:force": "node scripts/img-pipeline.mjs --force",
    "dev": "vite",
    "predev": "node scripts/img-pipeline.mjs",
    "typecheck": "tsc --noEmit",
    "ssr:check": "node scripts/ssr-smoke.mjs",
    "smoke": "node scripts/dom-smoke.mjs",
    "check": "tsc --noEmit && node scripts/ssr-smoke.mjs && node scripts/dom-smoke.mjs",
    "build": "tsc --noEmit && vite build",
    "prebuild": "node scripts/img-pipeline.mjs",
    "build:preview": "node scripts/build-preview.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "framer-motion": "^11.11.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.10",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.4.20",
    "jsdom": "^30.0.1",
    "postcss": "^8.4.47",
    "sharp": "^0.35.4",
    "tailwindcss": "^3.4.13",
    "typescript": "~5.5.4",
    "vite": "^5.4.8"
  }
}
